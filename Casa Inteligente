// ============================================================
// 5. FUNCOES AUXILIARES
// ============================================================

void buzzerOff() {
  digitalWrite(PIN_BUZZER, BUZZER_ACTIVE_HIGH ? LOW : HIGH);
  buzzerLigado = false;
}

void buzzerOn() {
  digitalWrite(PIN_BUZZER, BUZZER_ACTIVE_HIGH ? HIGH : LOW);
  buzzerLigado = true;
}

void solicitarApitos(int quantidade = 2) {
  apitosPendentes += quantidade;
  if (apitosPendentes > 10) apitosPendentes = 10;
}

void atualizarBuzzer() {
  unsigned long agora = millis();

  if (buzzerLigado) {
    if (agora - horarioBuzzer >= 120) {
      buzzerOff();
      horarioBuzzer = agora;
      aguardandoIntervaloBuzzer = true;
      apitosPendentes--;
    }
  } else if (aguardandoIntervaloBuzzer) {
    if (agora - horarioBuzzer >= 140) {
      aguardandoIntervaloBuzzer = false;
    }
  } else if (apitosPendentes > 0) {
    buzzerOn();
    horarioBuzzer = agora;
  }
}

// Atualiza o filtro de 50 ms sem bloquear o ESP32.
// Um pulso LOW menor que 50 ms e descartado.
// HIGH libera a deteccao imediatamente.
void atualizarSensoresIR() {
  unsigned long agora = millis();

  for (int i = 0; i < 3; i++) {
    bool leituraAtual = digitalRead(PIN_IR[i]);

    // Toda mudanca de nivel reinicia a contagem de estabilidade.
    if (leituraAtual != irUltimaLeitura[i]) {
      irUltimaLeitura[i] = leituraAtual;
      irInicioContagem[i] = agora;
    }

    if (leituraAtual == HIGH) {
      // Sensor livre: cancela qualquer deteccao anterior.
      irObstaculoConfirmado[i] = false;
    } else if (!irObstaculoConfirmado[i] &&
               agora - irInicioContagem[i] >= FILTRO_SENSOR_IR_MS) {
      // LOW estavel por 50 ms: obstaculo confirmado.
      irObstaculoConfirmado[i] = true;
    }
  }
}

bool obstaculoDetectado(int indice) {
  return irObstaculoConfirmado[indice];
}

bool umidadeDetectada() {
  return digitalRead(PIN_UMIDADE) == LOW;
}

void iniciarAbertura(int indice) {
  Janela &j = janelas[indice];
  j.alvoFechado = false;
  j.anguloAlvo = ANGULO_ABERTO[indice];
  j.estado = MOVENDO;
  j.novaTentativaPendente = false;
  j.ultimoPasso = millis();
}

void iniciarVerificacaoFechamento(int indice) {
  Janela &j = janelas[indice];
  j.alvoFechado = true;
  j.anguloAlvo = ANGULO_FECHADO[indice];
  j.estado = VERIFICANDO_FECHAMENTO;
  j.inicioVerificacao = millis();
  j.novaTentativaPendente = false;
}

void tratarObstaculoNoFechamento(int indice) {
  Janela &j = janelas[indice];

  // Abre imediatamente para liberar o obstaculo.
  j.alvoFechado = false;
  j.anguloAlvo = ANGULO_ABERTO[indice];
  j.estado = MOVENDO;
  j.ultimoPasso = millis();

  solicitarApitos(2);

  // Somente no automatico existe nova tentativa apos 5 segundos.
  if (chuvaEmAndamento) {
    j.novaTentativaPendente = true;
    j.horarioNovaTentativa = millis() + TEMPO_RETENTATIVA_MS;
  } else {
    j.novaTentativaPendente = false;
  }
}

void fecharJanela(int indice) {
  Janela &j = janelas[indice];

  if (j.estado == PARADA &&
      j.anguloAtual == ANGULO_FECHADO[indice] &&
      j.alvoFechado) {
    return;
  }

  iniciarVerificacaoFechamento(indice);
}

void abrirJanela(int indice) {
  iniciarAbertura(indice);
}

void comandarJanela(int indice, bool fechar) {
  if (indice < 0 || indice > 2) return;

  if (fechar) fecharJanela(indice);
  else abrirJanela(indice);
}

// ============================================================
// 6. CONTROLE INDEPENDENTE DAS TRES JANELAS
// ============================================================

void atualizarJanela(int indice) {
  Janela &j = janelas[indice];
  unsigned long agora = millis();

  // Durante o fechamento, qualquer LOW interrompe o movimento.
  if (j.estado == MOVENDO && j.alvoFechado && obstaculoDetectado(indice)) {
    tratarObstaculoNoFechamento(indice);
    return;
  }

  // Verificacao inicial de 100 ms antes de fechar.
  if (j.estado == VERIFICANDO_FECHAMENTO) {
    if (obstaculoDetectado(indice)) {
      tratarObstaculoNoFechamento(indice);
      return;
    }

    if (agora - j.inicioVerificacao >= TEMPO_VERIFICACAO_MS) {
      j.estado = MOVENDO;
      j.ultimoPasso = agora;
    }
  }

  // Movimento gradual, sem delay(), para nao bloquear os outros controles.
  if (j.estado == MOVENDO) {
    if (agora - j.ultimoPasso >= INTERVALO_PASSO_SERVO_MS) {
      j.ultimoPasso = agora;

      if (j.anguloAtual < j.anguloAlvo) {
        j.anguloAtual++;
        servos[indice].write(j.anguloAtual);
      } else if (j.anguloAtual > j.anguloAlvo) {
        j.anguloAtual--;
        servos[indice].write(j.anguloAtual);
      }

      if (j.anguloAtual == j.anguloAlvo) {
        j.estado = PARADA;
      }
    }
  }

  // Nova tentativa automatica somente depois de a janela terminar de abrir.
  if (j.estado == PARADA && j.novaTentativaPendente && chuvaEmAndamento) {
    if ((long)(agora - j.horarioNovaTentativa) >= 0) {
      fecharJanela(indice);
    }
  }
}

// ============================================================
// 7. MODO AUTOMATICO DO SENSOR DE UMIDADE
// ============================================================

void iniciarEventoDeUmidade() {
  chuvaEmAndamento = true;

  // Guarda o estado/objetivo de cada janela antes da chuva.
  for (int i = 0; i < 3; i++) {
    estadoAnteriorSalvo[i] = janelas[i].alvoFechado;
  }

  // Tenta fechar cada janela de forma independente.
  for (int i = 0; i < 3; i++) {
    if (!(janelas[i].estado == PARADA &&
          janelas[i].anguloAtual == ANGULO_FECHADO[i])) {
      fecharJanela(i);
    }
  }
}

void finalizarEventoDeUmidade() {
  chuvaEmAndamento = false;

  // Cancela tentativas pendentes e recupera os estados anteriores.
  for (int i = 0; i < 3; i++) {
    janelas[i].novaTentativaPendente = false;

    if (estadoAnteriorSalvo[i]) {
      fecharJanela(i);
    } else {
      abrirJanela(i);
    }
  }
}

void atualizarModoAutomatico() {
  umidadeAtiva = umidadeDetectada();

  bool condicaoDeChuva = modoAutomatico && umidadeAtiva;

  if (condicaoDeChuva && !chuvaEmAndamento) {
    iniciarEventoDeUmidade();
  } else if (!condicaoDeChuva && chuvaEmAndamento) {
    finalizarEventoDeUmidade();
  }
}

// ============================================================
// 8. API DA INTERFACE WEB
// ============================================================

void enviarStatus() {
  String json = "{";
  json += "\"automatico\":";
  json += (modoAutomatico ? "true" : "false");
  json += ",\"umidade\":";
  json += (umidadeAtiva ? "true" : "false");
  json += ",\"chuva\":";
  json += (chuvaEmAndamento ? "true" : "false");
  json += ",\"buzzer\":";
  json += ((buzzerLigado || apitosPendentes > 0) ? "true" : "false");
  json += ",\"janelas\":[";

  for (int i = 0; i < 3; i++) {
    if (i > 0) json += ",";

    String estado;
    if (janelas[i].estado == VERIFICANDO_FECHAMENTO) {
      estado = "Verificando seguranca";
    } else if (janelas[i].estado == MOVENDO) {
      estado = janelas[i].alvoFechado ? "Fechando" : "Abrindo";
    } else {
      estado = janelas[i].alvoFechado ? "Fechada" : "Aberta";
    }

    json += "{";
    json += "\"estado\":\"" + estado + "\",";
    json += "\"angulo\":" + String(janelas[i].anguloAtual) + ",";
    json += "\"obstaculo\":";
    json += (obstaculoDetectado(i) ? "true" : "false");
    json += "}";
  }

  json += "]}";
  server.send(200, "application/json", json);
}

void tratarComandoJanela() {
  if (!server.hasArg("i") || !server.hasArg("action")) {
    server.send(400, "application/json", "{\"erro\":\"Parametros ausentes\"}");
    return;
  }

  int indice = server.arg("i").toInt();
  String acao = server.arg("action");

  if (indice < 0 || indice > 2 || (acao != "open" && acao != "close")) {
    server.send(400, "application/json", "{\"erro\":\"Comando invalido\"}");
    return;
  }

  if (chuvaEmAndamento) {
    server.send(409, "application/json",
                "{\"erro\":\"Comandos manuais bloqueados enquanto a umidade estiver ativa\"}");
    return;
  }

  comandarJanela(indice, acao == "close");
  server.send(200, "application/json", "{\"ok\":true}");
}

void tratarModo() {
  if (!server.hasArg("enabled")) {
    server.send(400, "application/json", "{\"erro\":\"Parametro ausente\"}");
    return;
  }

  bool novoModo = (server.arg("enabled") == "1");

  if (novoModo != modoAutomatico) {
    modoAutomatico = novoModo;
    // A avaliacao imediata trata tambem o caso de ligar o automatico
    // quando o sensor ja esta detectando umidade.
    atualizarModoAutomatico();
  }

  server.send(200, "application/json", "{\"ok\":true}");
}

// ============================================================
// 9. SETUP
// ============================================================

void setup() {
  Serial.begin(115200);

  // Entradas com pull-up: HIGH = livre/seco; LOW = detectado.
  for (int i = 0; i < 3; i++) {
    pinMode(PIN_IR[i], INPUT_PULLUP);
    irUltimaLeitura[i] = digitalRead(PIN_IR[i]);
    irInicioContagem[i] = millis();
    irObstaculoConfirmado[i] = false;
  }
  pinMode(PIN_UMIDADE, INPUT_PULLUP);

  pinMode(PIN_BUZZER, OUTPUT);
  buzzerOff();

  // Inicializa cada servo na posicao inicial configurada.
  for (int i = 0; i < 3; i++) {
    servos[i].setPeriodHertz(50);
    servos[i].attach(PIN_SERVO[i], 500, 2400);

    int posicaoInicial = INICIAR_FECHADAS
                         ? ANGULO_FECHADO[i]
                         : ANGULO_ABERTO[i];

    janelas[i].anguloAtual = posicaoInicial;
    janelas[i].anguloAlvo = posicaoInicial;
    janelas[i].alvoFechado = INICIAR_FECHADAS;
    janelas[i].estado = PARADA;
    janelas[i].inicioVerificacao = 0;
    janelas[i].ultimoPasso = millis();
    janelas[i].novaTentativaPendente = false;
    janelas[i].horarioNovaTentativa = 0;

    servos[i].write(posicaoInicial);
  }

  // Por padrao, o sistema inicia em modo manual.
  modoAutomatico = false;
  umidadeAtiva = umidadeDetectada();
  chuvaEmAndamento = false;

  WiFi.mode(WIFI_AP);
  WiFi.softAP(WIFI_SSID, WIFI_SENHA);

  Serial.println();
  Serial.println("Sistema de janelas iniciado.");
  Serial.print("Rede Wi-Fi: ");
  Serial.println(WIFI_SSID);
  Serial.print("Acesse: http://");
  Serial.println(WiFi.softAPIP());

  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html; charset=utf-8", PAGINA_HTML);
  });

  server.on("/api/status", HTTP_GET, enviarStatus);
  server.on("/api/window", HTTP_GET, tratarComandoJanela);
  server.on("/api/mode", HTTP_GET, tratarModo);

  server.begin();
}

// ============================================================
// 10. LOOP PRINCIPAL
// ============================================================

void loop() {
  server.handleClient();

  // Filtra os tres sensores antes de qualquer decisao de seguranca.
  atualizarSensoresIR();

  atualizarModoAutomatico();

  // Cada janela e atualizada separadamente.
  for (int i = 0; i < 3; i++) {
    atualizarJanela(i);
  }

  atualizarBuzzer();

  delay(1); // pequena pausa para o ESP32 processar tarefas do Wi-Fi
}
