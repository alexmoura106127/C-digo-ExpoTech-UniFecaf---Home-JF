/*
  AUTOMACAO DE 3 JANELAS - ESP32 DevKit V1 (30 pinos)
  --------------------------------------------------
  Bibliotecas:
    - ESP32Servo (instalar pelo Gerenciador de Bibliotecas)
    - WiFi.h e WebServer.h (incluidas no pacote ESP32 da Arduino IDE)

  Rede Wi-Fi criada pelo ESP32:
    SSID: Janelas-ESP32
    Senha: janela123
    Endereco: http://192.168.4.1

  LOGICA DOS SENSORES:
    - Infravermelho: LOW = obstaculo; HIGH = livre.
    - Umidade:       LOW = umidade detectada; HIGH = sem umidade.

  IMPORTANTE:
    - Alimente os servos por uma fonte externa regulada de 5 V.
    - Una o GND da fonte externa ao GND do ESP32.
    - Nao alimente os tres servos pelo pino 5V/3V3 do ESP32.
    - Alimente os modulos LM393 com 3,3 V (ou use adaptacao de nivel
      se a saida do modulo estiver em 5 V). Os GPIOs do ESP32 NAO
      toleram 5 V.
*/

#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>

// ============================================================
// 1. CONFIGURACAO FACIL - ALTERE OS PINOS NESTA SECAO
// ============================================================

// Pinos dos tres servos SG90
const int PIN_SERVO[3] = {18, 19, 21};

// Pinos dos tres sensores infravermelhos (um por janela)
const int PIN_IR[3] = {25, 26, 27};

// Sensor digital de umidade
const int PIN_UMIDADE = 32;

// Buzzer ativo
const int PIN_BUZZER = 33;

// Se o seu modulo de buzzer ligar com LOW, altere para false.
const bool BUZZER_ACTIVE_HIGH = true;

// Posicoes individuais dos servos.
// 0 graus = janela aberta; 180 graus = janela fechada.
// Ajuste cada janela separadamente conforme a montagem mecanica.
int ANGULO_ABERTO[3]  = {10, 170, 170};
int ANGULO_FECHADO[3] = {170, 10, 10};

// Posicao inicial ao ligar o ESP32.
// false = iniciar com as tres janelas abertas.
// true  = iniciar com as tres janelas fechadas.
const bool INICIAR_FECHADAS = false;

// Velocidade: intervalo entre cada grau de movimento.
// Aumente para movimento mais lento; diminua para mais rapido.
const unsigned long INTERVALO_PASSO_SERVO_MS = 15;

// Tempo de verificacao antes de iniciar um fechamento.
const unsigned long TEMPO_VERIFICACAO_MS = 100;

// O sensor infravermelho so confirma obstaculo apos LOW continuo por este tempo.
const unsigned long FILTRO_SENSOR_IR_MS = 50;

// Tempo entre tentativas automaticas apos obstaculo.
const unsigned long TEMPO_RETENTATIVA_MS = 5000;
// ============================================================
// 2. CONFIGURACAO DO WI-FI
// ============================================================

const char* WIFI_SSID = "automação de Janelas";
const char* WIFI_SENHA = "janela123"; // minimo de 8 caracteres

WebServer server(80);
Servo servos[3];

// ============================================================
// 3. VARIAVEIS INTERNAS
// ============================================================

enum EstadoMovimento {
  PARADA,
  VERIFICANDO_FECHAMENTO,
  MOVENDO
};

struct Janela {
  int anguloAtual;
  int anguloAlvo;
  bool alvoFechado;
  EstadoMovimento estado;
  unsigned long inicioVerificacao;
  unsigned long ultimoPasso;
  bool novaTentativaPendente;
  unsigned long horarioNovaTentativa;
};

Janela janelas[3];

bool modoAutomatico = false;
bool umidadeAtiva = false;
bool chuvaEmAndamento = false;
bool estadoAnteriorSalvo[3] = {false, false, false};
bool buzzerLigado = false;
int apitosPendentes = 0;
unsigned long horarioBuzzer = 0;
bool aguardandoIntervaloBuzzer = false;

// Estados filtrados dos tres sensores infravermelhos.
// O LOW precisa permanecer continuo por FILTRO_SENSOR_IR_MS.
bool irObstaculoConfirmado[3] = {false, false, false};
bool irUltimaLeitura[3] = {HIGH, HIGH, HIGH};
unsigned long irInicioContagem[3] = {0, 0, 0};

// ============================================================
// 4. INTERFACE WEB
// ============================================================

